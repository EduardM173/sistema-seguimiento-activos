# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Configuración de despliegue Docker
#
# Copia este archivo a .env y ajusta los valores para tu entorno.
# El archivo .env está en .gitignore — nunca subas credenciales reales.
#
# Usado por: docker-compose.dev.yml | docker-compose.prod.yml | docker-compose.infra.yml
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos principal ───────────────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=postgres
POSTGRES_DB=activos_db
POSTGRES_PORT=5433

# ── Base de datos del agente (pgvector) ───────────────────────────────────────
AGENT_POSTGRES_USER=graphrag
AGENT_POSTGRES_PASSWORD=graphrag_secret
AGENT_POSTGRES_DB=graphrag

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag_secret

# ── Secretos de aplicación ────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
GOOGLE_API_KEY=your-google-api-key-here

# ── Nexus npm registry (solo para docker compose build) ───────────────────────
# Docker interno: http://nexus:8081/repository/activos/
# Desde el host:  http://localhost:20002/repository/activos/
NEXUS_URL=https://nexus.dontrisk.org/repository/activos/

# ── Puertos expuestos al host ─────────────────────────────────────────────────
DEV_FRONTEND_PORT=5174
PROD_GATEWAY_PORT=80
APP_DOMAIN=app.dontrisk.org
