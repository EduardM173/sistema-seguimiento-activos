FROM node:lts-alpine3.22

# Dependencias nativas que necesita Vite (esbuild, etc.)
RUN apk add --no-cache python3 make g++

RUN mkdir -p /app/frontend /app/common_library && chown -R node:node /app
WORKDIR /app/frontend

COPY --chown=node:node common_library/activos-config ../common_library/activos-config
COPY --chown=node:node frontend/package*.json ./

ARG NEXUS_URL
RUN if [ -z "${NEXUS_URL}" ]; then \
      echo "ERROR: El build-arg NEXUS_URL es obligatorio" >&2; \
      exit 1; \
    fi && \
    echo "@activos:registry=${NEXUS_URL}" >> .npmrc

USER node
RUN cd ../common_library/activos-config && npm ci && npm run build
RUN npm install

COPY --chown=node:node frontend/ .

EXPOSE 5173

# Vite dev server con HMR. El volumen montado desde el host
# provee el código fuente y activa el hot-reload.
CMD ["npm", "run", "dev"]
