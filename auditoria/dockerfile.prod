FROM node:lts-alpine3.22

RUN mkdir -p /app/auditoria /app/common_library && chown -R node:node /app
WORKDIR /app/auditoria

# ── Layer cacheado: solo cambia si cambian las dependencias ──
COPY --chown=node:node common_library/activos-config ../common_library/activos-config
COPY --chown=node:node auditoria/package*.json ./

ARG NEXUS_URL
RUN if [ -z "${NEXUS_URL}" ]; then \
      echo "ERROR: El build-arg NEXUS_URL es obligatorio" >&2; \
      exit 1; \
    fi && \
    echo "@activos:registry=${NEXUS_URL}" >> .npmrc

USER node
RUN cd ../common_library/activos-config && npm ci && npm run build
RUN npm ci --omit=dev

# ── Layer que cambia con el código ──
COPY --chown=node:node auditoria/src ./src

CMD ["node", "src/index.js"]
