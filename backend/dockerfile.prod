FROM node:lts-alpine3.22 AS builder

RUN mkdir -p /app/backend /app/common_library && chown -R node:node /app
WORKDIR /app/backend

COPY --chown=node:node common_library/activos-config ../common_library/activos-config
COPY --chown=node:node backend/package*.json ./

ARG NEXUS_URL
RUN if [ -z "${NEXUS_URL}" ]; then \
      echo "ERROR: El build-arg NEXUS_URL es obligatorio" >&2; \
      exit 1; \
    fi && \
    echo "@activos:registry=${NEXUS_URL}" >> .npmrc

USER node
RUN cd ../common_library/activos-config && npm ci && npm run build
RUN npm ci

COPY --chown=node:node backend/ .
RUN npm run build

# ── Runtime ─────────────────────────────────────────────────────────────────
FROM node:lts-alpine3.22

RUN mkdir -p /app/backend /app/common_library && chown -R node:node /app
WORKDIR /app/backend

COPY --chown=node:node common_library/activos-config ../common_library/activos-config
COPY --chown=node:node backend/package*.json ./

ARG NEXUS_URL
RUN if [ -z "${NEXUS_URL}" ]; then \
      echo "ERROR: El build-arg NEXUS_URL es obligatorio" >&2; \
      exit 1; \
    fi && \
    echo "@activos:registry=${NEXUS_URL}" >> .npmrc

USER node
RUN cd ../common_library/activos-config && npm ci && npm run build
RUN npm ci --omit=dev

COPY --from=builder --chown=node:node /app/backend/dist ./dist

# Prisma schema + migrations: needed at container start for `prisma migrate deploy`
# (see docker-compose.prod.yml backend command). The generated client lives under
# src/generated/prisma and is already compiled into ./dist.
COPY --chown=node:node backend/prisma ./prisma

# Directorio de uploads con permisos node para inicialización de volumen
RUN mkdir -p /app/uploads

CMD ["npm", "run", "start:prod"]
