FROM node:lts-alpine3.22

RUN mkdir -p /app/backend /app/common_library && chown -R node:node /app
WORKDIR /app/backend

# Instalar dependencias primero (layer cache)
COPY --chown=node:node common_library/activos-config ../common_library/activos-config
COPY --chown=node:node backend/package*.json ./

# Configurar Nexus como registry para @activos/*
ARG NEXUS_URL
RUN if [ -z "${NEXUS_URL}" ]; then \
      echo "ERROR: El build-arg NEXUS_URL es obligatorio" >&2; \
      exit 1; \
    fi && \
    echo "@activos:registry=${NEXUS_URL}" >> .npmrc

USER node
RUN cd ../common_library/activos-config && npm ci && npm run build
RUN npm install

# Crear directorio de uploads como usuario node para que el volumen
# se inicialice con los permisos correctos en el primer arranque
RUN mkdir -p /app/uploads

# Copiar el resto del código fuente
COPY --chown=node:node backend/ .

# El hot-reload de NestJS detecta cambios en el volumen montado
CMD ["npm", "run", "start:dev"]
